{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node tests/e2e_audit_test.js",
    "db:setup": "node -e \"require('dotenv').config(); const {execSync}=require('child_process'); const u=process.env.DB_USER||'root'; const p=process.env.DB_PASSWORD?'-p'+process.env.DB_PASSWORD:''; execSync('mysql -u '+u+' '+p+' < database/selihom_schema.sql',{stdio:'inherit'});\"",
    "db:seed": "node database/seed.js",
    "db:reset": "npm run db:setup && npm run db:seed"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "3.11.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "6.30.6",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
